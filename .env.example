# Copy to .env.local and fill in. See "Quote form setup" in README.md.

# Cloudflare R2 — where customer uploads are stored
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Resend — emails each quote request to you
RESEND_API_KEY=
# Optional. Defaults to QUOTE_INBOX_EMAIL in app/lib/business.ts.
QUOTE_TO_EMAIL=
# Optional. Defaults to QUOTE_FROM in app/lib/business.ts (an address on the
# domain verified in Resend).
QUOTE_FROM_EMAIL=

# Cloudflare Turnstile — invisible spam check (optional, but set before launch)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Client onboarding pages (/start/<slug>, admin at /start/admin)
# The admin password. Sign in once per device, or bookmark
# /api/start/admin/login?key=<ADMIN_KEY>. Also lets the Worker's cron send emails.
ADMIN_KEY=
# Optional. Where onboarding notifications to you go (default: BUSINESS_EMAIL).
ADMIN_NOTIFY_EMAIL=
# Optional. Sender for onboarding emails (default: R. Martin Creative <hello@rmartincreative.com>).
ONBOARDING_FROM_EMAIL=
