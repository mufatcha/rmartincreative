# Copy to .env.local and fill in. See "Quote form setup" in README.md.

# Cloudflare R2 — where customer uploads are stored
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Resend — emails each quote request to you
RESEND_API_KEY=
# Optional. Defaults to QUOTE_INBOX_EMAIL in app/lib/business.ts.
QUOTE_TO_EMAIL=
# Optional. Defaults to onboarding@resend.dev, which can only send to your own
# Resend account email. Verify your domain in Resend, then set e.g.
# "Ryan Martin Design <quotes@yourdomain.com>".
QUOTE_FROM_EMAIL=

# Cloudflare Turnstile — invisible spam check (optional, but set before launch)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
